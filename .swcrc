{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "module": {
    "type": "es6",
    "resolveFully": true
  },
  "jsc": {
    "target": "es2023",
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "baseUrl": "./",
    "paths": {
      "@common/*": ["./src/common/*/index.ts"],
      "@modules/*": ["./src/modules/*/index.ts"]
    }
  },
  "minify": false
}
