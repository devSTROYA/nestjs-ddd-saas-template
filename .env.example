PORT=8080
DATABASE_URL=postgres://user:password@host:5432/boilerplate
DATABASE_POOL_MAX=5
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RELAY_ENABLED=true
OTP_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_SECRET=replace-with-another-random-string-of-at-least-32-characters
RESEND_API_KEY=re_replace_with_your_resend_api_key
MAIL_FROM=Boilerplate <no-reply@your-verified-domain.com>
ADMIN_SEED_EMAIL=admin@example.com
